<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ad-hoc builds only. Ad-hoc signatures have no Team ID, so hardened-runtime
  library validation would refuse to load the embedded Sparkle.framework.
  Builds signed with a real identity (SIDESCREEN_SIGN_IDENTITY, e.g. your
  "Apple Development" cert) use SideScreen.entitlements, which has no
  exemptions. allow-unsigned-executable-memory is not needed by this app.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
